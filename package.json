{
  "name": "myclubsoftware",
  "version": "0.1.0",
  "bin": {
    "myclubsoftware": "bin/myclubsoftware.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc --build",
    "create-layers": "bash scripts/build-layers.sh",
    "update-helpers": "node scripts/copy-helpers.js",
    "predeploy": "node scripts/copy-helpers.js && npm run build",
    "deploy": "npm run predeploy && cdk deploy --all"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.147",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "20.14.9",
    "aws-cdk": "2.152.0",
    "aws-cdk-lib": "2.152.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.5",
    "ts-node": "10.9.2",
    "typescript": "~5.5.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.799.0",
    "@aws-sdk/client-dynamodb": "3.812.0",
    "@aws-sdk/client-s3": "^3.832.0",
    "@aws-sdk/client-ses": "^3.835.0",
    "@aws-sdk/client-sqs": "^3.835.0",
    "@aws-sdk/client-ssm": "3.772.0",
    "@aws-sdk/s3-request-presigner": "^3.832.0",
    "@aws-sdk/util-dynamodb": "3.812.0",
    "aws-lambda": "1.0.7",
    "constructs": "10.0.0",
    "dotenv": "16.4.7",
